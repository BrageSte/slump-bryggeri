# Copy to .dev.vars for local development.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Optional. Without it, sign-in codes are printed to the dev server log instead of emailed.
RESEND_API_KEY=
# Optional. Shared brewery code for brewery mode; leave empty for no code locally.
BREWERY_ACCESS_CODE=
# Optional. Anthropic API key for the brewing assistant (console.anthropic.com → API keys).
# Without it the assistant shows how to set it up; the rest of the app works as before.
ANTHROPIC_API_KEY=
# Optional. Web search is on by default; add this to .dev.vars to disable it locally.
# ASSISTANT_WEB_SEARCH=off
