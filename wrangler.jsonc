{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slump-bryggeri",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slump-bryggeri",
      "database_id": "a0ec5d51-4e8d-4225-bbfc-df649829ecb2",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "slump-bryggeri-files" }],
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "UPLOAD_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // Public URL of the app. Leave empty to derive it from the request (fine for local dev).
    "APP_URL": "",
    "EMAIL_FROM": "Slump Bryggeri <bryggeri@example.com>"
  },
  "env": {
    // Deployed with `npm run deploy` (CLOUDFLARE_ENV=production). Same as the top level, but without
    // the R2 binding until R2 is enabled on the account (Dashboard → R2). Photo uploads answer 503
    // until then. When R2 is on: create the bucket and copy the r2_buckets block in here.
    "production": {
      "name": "slump-bryggeri",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "slump-bryggeri",
          "database_id": "a0ec5d51-4e8d-4225-bbfc-df649829ecb2",
          "migrations_dir": "db/migrations"
        }
      ],
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "UPLOAD_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
      ],
      "vars": {
        "APP_URL": "",
        "EMAIL_FROM": "Slump Bryggeri <bryggeri@example.com>"
      }
    }
  }
}
