{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slump-bryggeri",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slump-bryggeri",
      // Replace with the real id from `wrangler d1 create slump-bryggeri` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "slump-bryggeri-files" }],
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "UPLOAD_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // Public URL of the app. Leave empty to derive it from the request (fine for local dev).
    "APP_URL": "",
    "EMAIL_FROM": "Slump Bryggeri <bryggeri@example.com>"
  }
}
